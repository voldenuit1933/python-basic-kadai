      "source": [
        "# 消費税を加えた計算結果を返す関数を記述\n",
        "def price_with_tax(price, tax: int):\n",
        "  tax_amount = price * tax / 100\n",
        "  total = price + tax_amount\n",
        "\n",
        "  # 関数の呼び出し：引数として商品金額と消費税を渡す\n",
        "  return total\n",
        "  print(total)\n",
        "\n",
        "# 第1引数に商品の金額「110」、第2引数に消費税（10%）の「10」を設定\n",
        "price_with_tax(110, 10)\n"
      ]
    }
  ]
}