      "source": [
        "# 消費税を加えた計算結果を返す関数を記述\n",
        "def add_two_arguments(price, shipping_fee):\n",
        "  total = price + (shipping_fee / 100)\n",
        "\n",
        "  # 変数$taxの値を出力\n",
        "  print(f\"{total}\")\n",
        "\n",
        "# 関数の呼び出し：引数として商品金額と消費税を渡す\n",
        "# 第1引数に商品の金額「110」、第2引数に消費税（10%）の「10」を設定\n",
        "add_two_arguments(110, 10)"
      ]
